GROQ_API_KEY=your_groq_api_key_here
TAVILY_API_KEY=your_tavily_api_key_here

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/langgraph
CHECKPOINT_DB=checkpoints.sqlite
MEMORY_MIN_SCORE=0.3
MEMORY_SEARCH_LIMIT=200
EMBEDDING_MODEL=all-MiniLM-L6-v2

MCP_SERVER_URL=http://localhost:8000/mcp
MCP_PORT=8000
# read_file is disabled until this is an absolute directory
MCP_ALLOWED_DIR=
# comma-separated hostnames; read_url is disabled until set
MCP_ALLOWED_HOSTS=

# JSON mapping of bearer token to user ID
AUTH_TOKENS={"local-token":"local-user"}
